# Local development only. Copy to supabase/.env.local and fill in.
# supabase/.env.local is gitignored and must never be committed.
#
# In production you do NOT set these here. Supabase injects SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY into the function automatically, and ALLOWED_ORIGINS
# is set once with `supabase secrets set`.
#
# Both values are in the dashboard: Project Settings -> API.
# Use the SECRET key (sb_secret_... or service_role), not the publishable one.
# It bypasses row level security, so it is server side only and must never
# reach a browser or any VITE_ prefixed variable.

SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Origins allowed to call the function. The dev server ports are always
# allowed, so this only matters once there is a deployed frontend.
ALLOWED_ORIGINS=http://localhost:5173
