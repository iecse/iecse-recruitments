# ---------------------------------------------------------------------------
# IECSE Recruitment API — copy this file to server/.env and fill it in.
# Nothing here is read by the frontend. The Vite app talks to /api only.
# ---------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Comma separated list of production origins allowed to call the API.
# localhost dev ports are always allowed and do not need listing here.
# CORS_ORIGINS=https://apply.iecse-manipal.com

# ---- Storage. Pick exactly one. ----

# 1. Nothing set (default): better-sqlite3 writes server/db/iecse_recruitment.db.
#    Zero setup, fine for local work, not for production.

# 2. PostgreSQL. Run `npm run init:pg` once to create the table and indexes.
# DATABASE_URL=postgresql://user:pass@host:5432/iecse_recruitment

# 3. Supabase. Takes priority over DATABASE_URL when both are set.
#    Use the SERVICE ROLE key, not the publishable one: this runs on the
#    server, and the service role is what lets the duplicate check read the
#    table without opening it up to the public anon role.
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_KEY=your-service-role-key
