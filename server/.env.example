# ---------------------------------------------------------------------------
# IECSE Recruitment API — copy this file to server/.env and fill it in.
# server/.env is gitignored. Nothing here is read by the frontend: the browser
# talks to /api and never to the database.
# ---------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Number of proxies in front of this app. Read SECURITY.md before changing it.
# Trusting a proxy that is not there lets anyone spoof their address through
# X-Forwarded-For and the rate limits stop applying. 0 means no proxy.
TRUST_PROXY=0

# Comma separated production origins allowed to call the API.
# localhost dev ports are always allowed and do not need listing.
# CORS_ORIGINS=https://apply.iecse-manipal.com

# ---- Storage. Pick exactly one. ----

# 1. Nothing set (default): SQLite at server/db/iecse_recruitment.db.
#    Zero setup, fine for local work, not for production.

# 2. Supabase. Takes priority over DATABASE_URL when both are set.
#    Run server/db/supabase-schema.sql in the project first.
#    SUPABASE_KEY is the SERVICE ROLE key, not the publishable one. It runs
#    server side only and must never be given to the frontend: it bypasses row
#    level security. If you paste it anywhere a browser can see, rotate it.
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_KEY=your-service-role-key

# 3. PostgreSQL direct. Run `npm run init:pg` once to create the table.
# DATABASE_URL=postgresql://user:pass@host:5432/iecse_recruitment
