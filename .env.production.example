# Copy to .env.production before building for deployment.
#
# Vite reads this automatically on `npm run build`, which avoids the
# VITE_API_BASE=... npm run build syntax. That form is bash only and silently
# does nothing on Windows PowerShell: the build succeeds, the variable is
# unset, the page ships calling /api, and every submission 404s against the
# static host. A file works the same in every shell.
#
# Not a secret. Anything VITE_ prefixed is compiled into the bundle and is
# public. This is just the address of the API.
#
# <your-ref> is the project ref from the Supabase dashboard URL, or
# Project Settings -> General -> Reference ID.

VITE_API_BASE=https://<your-ref>.supabase.co/functions/v1
